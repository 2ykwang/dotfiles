{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "ask": [
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh gist create:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "mcp__plugin_slack_slack__slack_create_conversation",
      "mcp__plugin_slack_slack__slack_add_reaction",
      "mcp__notion__notion-create-pages",
      "mcp__notion__notion-update-page",
      "mcp__notion__notion-create-comment",
      "mcp__notion__notion-create-database",
      "mcp__notion__notion-duplicate-page",
      "mcp__notion__notion-move-pages",
      "mcp__notion__notion-update-data-source",
      "mcp__notion__notion-create-attachment",
      "mcp__notion__notion-create-view",
      "mcp__notion__notion-update-view",
      "mcp__redash__update_dashboard",
      "mcp__redash__share_dashboard",
      "Artifact"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/dotfiles/scripts/statusline.py"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "html-visual@2ykwang-agent-skills": true,
    "swift-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "check-agent-doc@2ykwang-agent-skills": true,
    "decision-board@2ykwang-agent-skills": true,
    "ponytail@ponytail": true,
    "vercel@claude-plugins-official": true,
    "write-pr@2ykwang-agent-skills": true,
    "quick-pr@2ykwang-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "2ykwang-agent-skills": {
      "source": {
        "source": "github",
        "repo": "2ykwang/agent-skills"
      }
    }
  },
  "language": "Korean",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "pluginConfigs": {
    "grafana-mcp@claude-plugins-official": {
      "options": {
        "grafana_url": "https://riiid.grafana.net"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "verbose": false,
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754086736007
  }
}
