// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "git-firefly": true,
    "github-theme": true,
    "html": true,
    "make": true,
    "swift": true,
    "toml": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "git": {
    "diff_base": "head",
    "inline_blame": {
      "enabled": false,
    },
  },
  "format_on_save": "on",
  "use_smartcase_search": true,
  "vertical_scroll_margin": 8,
  // Replaces Zed's default list, so the defaults are repeated here before the additions.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
  ],
  "proxy": "",
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "agent": "codex:codex-rescue",
        "fast": true,
        "model": "opus[1m]",
        "mode": "default",
      },
      "type": "registry",
    },
  },
  "auto_signature_help": false,
  "mouse_wheel_zoom": true,
  "which_key": {
    "enabled": false,
  },
  "code_lens": "on",
  "lsp_document_colors": "inlay",
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "message_editor_min_lines": 4,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_buffer_font_size": 17.0,
  "agent_ui_font_size": 17.0,
  "buffer_font_weight": 450.0,
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
  },
  "debugger": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "GitHub Dark",
  },
}
